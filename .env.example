# Vorlage für die .env-Datei des Servers. Kopieren nach `.env` (liegt nicht
# im Git-Repository) und die Werte eintragen. Echte Umgebungsvariablen, z. B.
# aus der systemd-Unit, haben Vorrang vor dieser Datei.

# Passwort für alle Ansichten außer /team.html und /join.html.
# Ohne Eintrag erzeugt der Server bei jedem Start ein zufälliges und zeigt es in der Konsole.
SITE_PASSWORD=

# Optional: fester Schlüssel für den Login-Cookie. Ohne Eintrag werden beim
# Neustart alle ausgeloggt. Erzeugen z. B. mit: openssl rand -hex 32
SESSION_SECRET=d91686c05ed0a883424ce0ff8c055d6b2567abe7911956206fd483d7d9b188e2

# Spotify-App aus https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
